[Unit]
Description=Tuxchange -- StreetPass a Nintendo 3DS from Linux
Documentation=https://github.com/finthetechguy/Tuxchange/wiki
After=network.target
Wants=network.target

# A wedge costs this service and nothing else, so these must never be reboot or poweroff.
FailureAction=none
SuccessAction=none
StartLimitAction=none
# No rate limit, so a radio that comes back after an hour is picked up.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=__ROOT__

# Everything tunable lives here; edit /etc/default/tuxchange, not this file.
EnvironmentFile=-/etc/default/tuxchange
# Empty picks an adapter that supports active monitor (ath9k first), else an unconnected one
# for mixed mode. Set it in /etc/default/tuxchange to pin one.
Environment=SP_IFACE=
# auto: active monitor when the adapter supports it, mixed mode otherwise; or force active/mixed.
Environment=SP_MODE=auto
Environment=SP_MON=mon0
Environment=SP_STORE=/var/lib/tuxchange
Environment=SP_CHANNELS=1,6,11
Environment=SP_WINDOW=180
Environment=SP_IDLE=2
# Identity rotation in seconds; 0 never rotates. A typo turns rotation off instead of crash-looping.
Environment=SP_ROTATE=0
# Per-pass logs in <store>/runs: on or off.
Environment=SP_LOGS=on
Environment=SP_EXTRA=
# The one desktop user allowed to use the control socket; empty means root only.
Environment=SP_CONTROL_USER=__GUI_USER__
# Root-owned, and listed last so it wins over the settings above.
EnvironmentFile=-/var/lib/tuxchange/relay.env

# Rebuilt on every (re)start, so a restart is also the recovery for a wedged interface.
ExecStartPre=__ROOT__/scripts/sp_monitor.sh up
ExecStart=/bin/sh -c 'exec __PY__ __ROOT__/tuxchange/sp_relay.py run --store "$SP_STORE" --iface "$SP_MON" --channel "$SP_CHANNELS" --window "$SP_WINDOW" --idle "$SP_IDLE" --rotate-every "$SP_ROTATE" --run-logs "$SP_LOGS" --control-user "$SP_CONTROL_USER" --settings-file /var/lib/tuxchange/relay.env $SP_EXTRA'
ExecStopPost=__ROOT__/scripts/sp_monitor.sh down

# The daemon sends WATCHDOG=1 from inside its sniffing loop, at most every 5 s.
WatchdogSec=120
Restart=always
RestartSec=15
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=mixed

CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SETUID CAP_SETGID CAP_KILL
NoNewPrivileges=no
ProtectHostname=yes
ProtectKernelTunables=no
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=tuxchange

[Install]
WantedBy=multi-user.target
