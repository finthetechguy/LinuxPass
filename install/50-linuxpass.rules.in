// LinuxPass -- polkit rule.
//
// The GUI runs as an ordinary desktop user and needs to start and stop ONE unit. Without this,
// `systemctl start linuxpass` from a desktop session fails with "interactive authentication
// required" unless a polkit agent happens to be running. The alternatives are worse: a stored
// password in an askpass helper, or a blanket sudoers line. This grants exactly one verb, on
// exactly one unit, to exactly one user.
//
// install.sh writes this file with __GUI_USER__ substituted, and `uninstall` removes it.
// LinuxPass never writes to /etc/sudoers.d.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "linuxpass.service" &&
        subject.user == "__GUI_USER__") {
        return polkit.Result.YES;
    }
});
