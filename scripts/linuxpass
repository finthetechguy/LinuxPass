#!/bin/bash
# Run LinuxPass in the foreground: monitor up, daemon, machine put back on exit.
#   sudo ./scripts/linuxpass [iface] [channels] [sp_relay.py run arguments]
set -u

IFACE=${1:-}          # empty: sp_monitor.sh picks an ath9k adapter
CH=${2:-1,6,11}
shift 2 2>/dev/null || shift $# 2>/dev/null
MON=${SP_MON:-mon0}
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=python3

# --store may be given in the passthrough arguments; find it so the identity matches the store.
STORE=relay_store
prev=""
for arg in "$@"; do
  [ "$prev" = "--store" ] && STORE=$arg
  prev=$arg
done
case "$STORE" in /*) ;; *) STORE="$ROOT/$STORE" ;; esac

if [ "$(id -u)" -ne 0 ]; then echo "needs root; re-run with sudo."; exit 1; fi

OURMAC=$("$PY" "$ROOT/linuxpass/sp_relay.py" identity --store "$STORE" 2>/dev/null)
echo "interface $IFACE -> $MON, channels $CH"
echo "store      $STORE"
echo "identity   $OURMAC (fixed; --rotate-identity changes it per exchange)"

cleanup() {
  echo
  echo "cleaning up..."
  SP_IFACE=$IFACE SP_MON=$MON SP_STORE=$STORE "$HERE/sp_monitor.sh" down
}
trap cleanup EXIT INT TERM

SP_IFACE=$IFACE SP_MON=$MON SP_STORE=$STORE "$HERE/sp_monitor.sh" up || exit 1
echo
echo "control socket: $STORE/relay.sock"
echo "  $PY $ROOT/linuxpass/sp_relay.py ctl status  --store $STORE"
echo "  $PY $ROOT/linuxpass/sp_relay.py ctl pause   --store $STORE"
echo
"$PY" "$ROOT/linuxpass/sp_relay.py" run --store "$STORE" --iface "$MON" --channel "$CH" "$@"
